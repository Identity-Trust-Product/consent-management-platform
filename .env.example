# ==============================================================================
# Open-Bharat-Digital-Consent-by-IDfy - Environment Configuration
# ==============================================================================
# Copy this file to .env.local and update the values for your environment.

# ------------------------------------------------------------------------------
# 1. Core Application Settings
# ------------------------------------------------------------------------------
# The base URL of the application (used for links in emails, etc.)
BASE_PATH="http://localhost:3000/cms"

# Data-exchange frontend used after a consent request is completed.
NEXT_PUBLIC_DATA_EXCHANGE_APP_URL="http://localhost:3000"

# Environment mode: "development", "production", or "test"
NODE_ENV="development"

# ------------------------------------------------------------------------------
# 2. Database (PostgreSQL)
# ------------------------------------------------------------------------------
# Connection string for Prisma
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://user:password@localhost:5432/privy_opencms"

# ------------------------------------------------------------------------------
# 3. Authentication (NextAuth.js)
# ------------------------------------------------------------------------------
# Secret key for signing JWTs and encrypting session data.
# Generate a secure key using: openssl rand -base64 32
AUTH_SECRET="change-me-to-a-secure-random-string"

# ------------------------------------------------------------------------------
# 4. Email Service (Postmark)
# ------------------------------------------------------------------------------
# Provider to use. Currently supports: "postmark"
EMAIL_PROVIDER="postmark"

# Postmark Server API Token
POSTMARK_API_KEY="your-postmark-server-token"

# Sender details (must be a verified sender signature in Postmark)
EMAIL_FROM_ADDRESS="noreply@yourdomain.com"
EMAIL_FROM_NAME="Open-Bharat-Digital-Consent-by-IDfy"

# ------------------------------------------------------------------------------
# 5. File Storage
# ------------------------------------------------------------------------------
# Storage provider to use. Options: "local", "gcs", "s3"
STORAGE_PROVIDER="local"

# Maximum file size for uploads in MB (Default: 5)
MAX_FILE_SIZE_MB="5"

# --- Local Storage Configuration (if STORAGE_PROVIDER="local") ---
# Path relative to project root where files will be stored
# LOCAL_STORAGE_PATH="./public/uploads"
# Base URL path for serving files
# LOCAL_STORAGE_BASE_URL="/cms/uploads"

# --- Google Cloud Storage (if STORAGE_PROVIDER="gcs") ---
# GCS_PROJECT_ID="your-gcp-project-id"
# GCS_BUCKET_NAME="your-gcs-bucket-name"
# Path to service account JSON key file
# GCS_KEYFILE_PATH="./path/to/service-account.json"
# Or use Application Default Credentials (true/false)
# GCS_USE_APPLICATION_DEFAULT="false"
# Signed URL expiry time in seconds (Default: 3600)
# GCS_URL_EXPIRY="3600"

# --- AWS S3 (if STORAGE_PROVIDER="s3") ---
# AWS_REGION="us-east-1"
# AWS_S3_BUCKET="your-s3-bucket-name"
# AWS_ACCESS_KEY_ID="your-access-key-id"
# AWS_SECRET_ACCESS_KEY="your-secret-access-key"
# Or use IAM Role (true/false)
# AWS_USE_IAM_ROLE="false"

# ------------------------------------------------------------------------------
# 6. Translation Service (Google Cloud Translate)
# ------------------------------------------------------------------------------
# Uses the same credentials as GCS if configured.
# Required for auto-translating privacy notices.
# GCS_PROJECT_ID="your-gcp-project-id"
# GCS_KEYFILE_PATH="./path/to/service-account.json"

# ------------------------------------------------------------------------------
# 7. Analytics Dashboard (Metabase)
# ------------------------------------------------------------------------------
# Metabase embedded dashboard URL (with JWT token and parameters)
# Get this from Metabase Admin → Settings → Embedding → Your Dashboard → Embed Code
# This is accessed at runtime (not build time), so no NEXT_PUBLIC_ prefix needed
# METABASE_DASHBOARD_URL
